MCP_DOMAIN=mcp.example.edu
LIGHTRAG_WEBUI_DOMAIN=lightrag.example.edu
TRAEFIK_NETWORK=n8n-compose_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

LIGHTRAG_API_KEY=
LIGHTRAG_MCP_TIMEOUT=120

# The public MCP tool stays simple; these limits are managed by developers.
# Keep `normal` in production until the directed-retrieval benchmark passes.
MCP_RETRIEVAL_STRATEGY=normal
MCP_DIRECTED_EDGE_DIRECTION=both
MCP_DIRECTED_HOP_DEPTH=2
MCP_DIRECTED_CHAIN_TOP_K=20
MCP_DIRECTED_MIN_IMPORTANCE=0.45

MCP_AUTH_REQUIRED=true
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://mcp.example.edu
AUTH0_ALGORITHMS=RS256

# Developer/admin WebUI login via oauth2-proxy in front of LightRAG.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_ISSUER_URL=https://your-tenant.eu.auth0.com/
OAUTH2_PROXY_EMAIL_DOMAINS=*

# Optional developer allowlist for the read-only Cypher Explorer in the
# Knowledge Graph WebUI. Leave empty to allow every authenticated WebUI user.
# GRAPH_CYPHER_EXPLORER_ALLOWED_EMAILS=developer1@example.edu,developer2@example.edu

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j

ENTITY_TYPE_PROMPT_FILE=pem_graphrag_entity_type_prompt.yml
ENTITY_EXTRACTION_USE_JSON=true

# Versioned extraction provenance. Bump EXTRACTION_ALGORITHM_VERSION whenever
# you intentionally change the extraction prompt, parser, ontology, or relation
# semantics. The fingerprint also detects prompt/config changes automatically.
EXTRACTION_ALGORITHM_VERSION=1.0.0
RELATION_SCHEMA_VERSION=1
# Set during deployment when a Git commit should be shown in document and
# benchmark provenance. It is informational and must not contain credentials.
EXTRACTION_GIT_COMMIT=

# Isolated, metered extraction-prompt experiments from the Evaluation WebUI.
# Keep both switches false in production until the staging workflow is tested.
PROMPT_EXPERIMENTS_ENABLED=false
PROMPT_EXPERIMENT_PROMOTION_ENABLED=false
PROMPT_EXPERIMENT_INPUT_COST_PER_MILLION=0.75
PROMPT_EXPERIMENT_OUTPUT_COST_PER_MILLION=4.50
PROMPT_EXPERIMENT_SYSTEM_OVERHEAD_TOKENS=1800
PROMPT_EXPERIMENT_ESTIMATED_OUTPUT_TOKENS=800
PROMPT_EXPERIMENT_SCREENING_CHUNKS_PER_DOCUMENT=10
PROMPT_EXPERIMENT_MAX_DOCUMENTS=20
PROMPT_EXPERIMENT_MAX_PROFILES=5
# Set true only while diagnosing a candidate workspace; it consumes storage.
PROMPT_EXPERIMENT_KEEP_CANDIDATE_WORKSPACE=false

LLM_BINDING=ollama
LLM_BINDING_HOST=http://ollama:11434
LLM_MODEL=qwen2.5:7b
LLM_BINDING_API_KEY=
LLM_TIMEOUT=300

# Azure OpenAI alternative:
# LLM_BINDING=azure_openai
# LLM_BINDING_HOST=https://your-resource.openai.azure.com/
# LLM_MODEL=your-chat-deployment-name
# LLM_BINDING_API_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional: use a stronger model only for entity/relation extraction.
# Leave unset to inherit the normal LLM_* settings.
EXTRACT_LLM_BINDING=
EXTRACT_LLM_BINDING_HOST=
EXTRACT_LLM_MODEL=
EXTRACT_LLM_BINDING_API_KEY=
EXTRACT_LLM_TIMEOUT=900
EXTRACT_MAX_ASYNC_LLM=1
MAX_ASYNC=1

# Optional: asynchronous Azure Batch extraction for chunked documents.
# This is separate from EXTRACT_LLM_* so the normal extraction path remains
# available as a fallback.
AZURE_BATCH_ENABLED=false
AZURE_BATCH_BINDING_HOST=https://your-resource.services.ai.azure.com/openai/v1
AZURE_BATCH_API_KEY=
AZURE_BATCH_MODEL=gpt-4.1-mini
AZURE_BATCH_ENDPOINT=/chat/completions
AZURE_BATCH_COMPLETION_WINDOW=24h
AZURE_BATCH_POLL_SECONDS=60
AZURE_BATCH_HTTP_TIMEOUT=120
AZURE_BATCH_MAX_OUTPUT_TOKENS=

EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_TIMEOUT=300

# Optional Azure embeddings. If you switch embeddings to Azure/OpenAI, clear the
# existing vector storage first because old Ollama vectors use a different space.
# EMBEDDING_BINDING=azure_openai
# EMBEDDING_BINDING_HOST=https://your-resource.openai.azure.com/
# EMBEDDING_MODEL=your-embedding-deployment-name
# EMBEDDING_DIM=1536
# EMBEDDING_BINDING_API_KEY=your_azure_openai_key
# AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_EMBEDDING_API_KEY=your_azure_openai_key
# AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
# AZURE_EMBEDDING_API_VERSION=2024-08-01-preview
