{
  "id": "pem_three_document_multihop_quality",
  "name": "PEM Three-Document Multi-Hop Quality",
  "description": "A demanding, evidence-audited benchmark for meaningful directed multi-hop retrieval across three PEM/VDMA battery-production guides. It evaluates causal depth, root-cause direction, production order, source grounding, and whether intermediate mechanisms survive extraction and retrieval.",
  "version": 1,
  "default_mode": "mix",
  "document_scope": [
    {
      "file": "Komponentenherstellung+einer+Lithium-Ionen-Batteriezelle+2023+(ENG).pdf",
      "title": "Production of Lithium-Ion Battery Cell Components",
      "edition": "2nd edition, 2023"
    },
    {
      "file": "Production+of+a+Solid-State+Battery+Cell+(2026-03).pdf",
      "title": "Production of a Solid-State Battery Cell",
      "edition": "3rd edition, 2026"
    },
    {
      "file": "Production+Process+of+Battery+Modules+and+Battery+Packs+(2026-03).pdf",
      "title": "Production Process of Battery Modules and Battery Packs",
      "edition": "5th edition, 2026"
    }
  ],
  "benchmark_objectives": [
    "Prefer ordered mechanisms over topical co-occurrence.",
    "Distinguish upstream root causes from downstream consequences.",
    "Require meaningful intermediate entities in two-hop and three-hop chains.",
    "Preserve process order for manufacturing-chain questions.",
    "Require every directed path to resolve to a real source chunk and document reference.",
    "Exercise English and German routing without translating the source terminology away."
  ],
  "quality_gates": {
    "min_scores": {
      "overall": 70,
      "graph": 65,
      "metadata": 80,
      "retrieval": 75,
      "directed": 70
    },
    "min_metadata_coverage": {
      "directionality": 90,
      "relation_type": 90,
      "relation_importance": 85,
      "chain_role": 75,
      "specific_relation_type": 90
    },
    "min_directed_strategy_scores": {
      "directed": 70,
      "combined": 75,
      "auto": 75
    },
    "max_failed_checks": 12,
    "require_directed_cases": true
  },
